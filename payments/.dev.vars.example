# Copy to .dev.vars (gitignored) for `wrangler dev` local testing.
# In production these are set with `wrangler secret put <NAME>`, never with
# [vars] in wrangler.toml and never committed.

PAYNOW_INTEGRATION_KEY=paste-the-paynow-integration-key-here
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
SUPABASE_SECRET_KEY=paste-the-supabase-secret-or-service-role-key-here

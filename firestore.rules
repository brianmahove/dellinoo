rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The admin panel (lib/features throughout admin/, a separate app) is the
    // only client allowed to write products/delivery_areas/order status.
    // Membership is an allowlist keyed by email — `admins/{email}` existing
    // means that address is an admin — so it works even before that person
    // has ever signed into any Dellinoo app (no uid needed yet). Managed
    // from the panel's own Admins screen (admin/lib/admins_screen.dart);
    // any admin can add or remove another.
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      // mahovebrian@gmail.com manages the other admins, so no other admin
      // account can remove it — only that account can remove itself (it
      // can't via the panel's own UI, but the rule doesn't need to assume
      // that). Mirrored in admin/lib/admins_screen.dart's UI-level check.
      allow delete: if isAdmin() &&
        (email != 'mahovebrian@gmail.com' || request.auth.token.email == 'mahovebrian@gmail.com');
    }

    // Catalogue is public to read (no login needed to browse); only admins write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo codes: a signed-in customer may fetch one code *by exact id* (to
    // validate what they typed) but can't list them all; only admins write.
    // The payments Worker re-validates the code itself before charging.
    match /coupons/{code} {
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
    }

    // "Request an item" (customer app → admin quote). A customer creates
    // their own as `new` and reads only theirs; only admins quote/close.
    match /item_requests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == 'new' && request.resource.data.link is string &&
        request.resource.data.link.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // Product reviews: public to read; one per customer per product (the doc
    // id is `{productId}_{uid}`, so a second review overwrites the first).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        reviewId == request.resource.data.productId + '_' + request.auth.uid &&
        request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // "Request an invoice" (customer app -> admin issues one). Same shape as
    // item_requests above: the customer creates their own as `new`, reads
    // only theirs, and only admins issue/close. The bill-to details are the
    // customer's own (company name, TIN) so they're written client-side.
    match /invoice_requests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == 'new' && request.resource.data.orderDocId is string;
      allow update, delete: if isAdmin();
    }

    // Issued invoices. Written only by the admin panel (it snapshots the
    // order's lines and totals at issue time, so an invoice never changes
    // under the customer's feet); the customer can read their own, which is
    // what shows the invoice number on the order screen.
    match /invoices/{invoiceId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isAdmin();
    }

    // Orders belong to the signed-in user who placed them (see
    // firestore_order_repository.dart). No guest orders — checkout requires
    // sign-in (see router.dart). Admins can read every order and update
    // status (processing, shipped, etc.); customers can only create/read
    // their own and never change status themselves.
    match /orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Manual payment: the owner may record (or correct) the transaction
      // reference they paid with, only while the order is still unpaid, and
      // only as `submitted` — confirming it (and appending `paid`) is the
      // admin's job. See lib/widgets/manual_payment.dart.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == resource.data.userId &&
        resource.data.history[resource.data.history.size() - 1].status == 'placed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['manualPayment', 'payment']) &&
        request.resource.data.payment == 'manual' &&
        request.resource.data.manualPayment.keys().hasOnly(['channel', 'reference', 'sender', 'status', 'submittedAt']) &&
        request.resource.data.manualPayment.status == 'submitted' &&
        request.resource.data.manualPayment.channel in ['ecocash', 'innbucks', 'bank'] &&
        request.resource.data.manualPayment.reference is string &&
        request.resource.data.manualPayment.reference.size() >= 4 &&
        request.resource.data.manualPayment.reference.size() <= 60 &&
        (!('sender' in request.resource.data.manualPayment) ||
          (request.resource.data.manualPayment.sender is string && request.resource.data.manualPayment.sender.size() <= 60)) &&
        request.resource.data.manualPayment.submittedAt is timestamp
      );
      allow delete: if false;
    }

    // The client's own accounts customers pay into manually (EcoCash /
    // InnBucks numbers, bank details) — edited on the admin panel's Payment
    // details screen, shown in the customer app's manual payment sheet.
    match /meta/paymentDetails {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Generates the human-friendly "DL#####" order numbers. Any signed-in
    // client may read it and bump it by exactly 1 as part of placing an
    // order (see the transaction in firestore_order_repository.dart) — the
    // +1 check stops a client claiming an arbitrary block of numbers.
    match /meta/orderCounter {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null && request.resource.data.next == resource.data.next + 1;
    }

    // Catalogue version stamp: bumped by the admin panel on every product
    // write (admin/lib/catalog_version.dart), read by every app launch to
    // decide whether its cached product list is still current.
    match /meta/catalog {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Generates the sequential "INV-00001" invoice numbers. Unlike
    // meta/orderCounter, only admins ever touch this one — invoices are
    // issued from the panel, never by a customer.
    match /meta/invoiceCounter {
      allow read, write: if isAdmin();
    }

    // A customer's own saved delivery addresses (see AddressBookNotifier in
    // state/providers.dart) — entirely private, never read by anyone else
    // (not even admins; admins see the delivery address already captured on
    // each order, which is a separate, order-scoped copy).
    match /users/{uid}/addresses/{addressId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Push notification device tokens (doc id = the FCM token itself; see
    // lib/core/push.dart). Written by the customer's own device, read only
    // by the payments Worker, which bypasses these rules as a service account.
    match /users/{uid}/fcmTokens/{token} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The customer's own profile doc — currently only notification prefs
    // (`priceDropAlerts`), read by the Worker's price-drop job.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Synced wishlist (WishlistNotifier). `savedPrice` is the customer's;
    // `notifiedPrice` is written by the Worker's price-drop job (service
    // account, bypasses these rules). Owner-only either way.
    match /users/{uid}/wishlist/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // In-app notification inbox. The payments Worker writes one doc per push
    // it sends this customer (service account, bypasses these rules). The
    // customer can read theirs, mark them read (only the `read` field), and
    // delete them; never create one.
    match /users/{uid}/notifications/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
    }

    // Public copies of promo broadcasts, merged into every customer's inbox.
    // Written only by the Worker; no admin details in them.
    match /promos/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Promo pushes sent from the admin Notifications screen. Written only by
    // the Worker (it logs each broadcast after sending); admins read history.
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}

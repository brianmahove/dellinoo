rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The admin panel (lib/features throughout admin/, a separate app) is the
    // only client allowed to write products/delivery_areas/order status.
    // Membership is an allowlist keyed by email — `admins/{email}` existing
    // means that address is an admin — so it works even before that person
    // has ever signed into any Dellinoo app (no uid needed yet). Managed
    // from the panel's own Admins screen (admin/lib/admins_screen.dart);
    // any admin can add or remove another.
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      // mahovebrian@gmail.com manages the other admins, so no other admin
      // account can remove it — only that account can remove itself (it
      // can't via the panel's own UI, but the rule doesn't need to assume
      // that). Mirrored in admin/lib/admins_screen.dart's UI-level check.
      allow delete: if isAdmin() &&
        (email != 'mahovebrian@gmail.com' || request.auth.token.email == 'mahovebrian@gmail.com');
    }

    // Catalogue is public to read (no login needed to browse); only admins write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo codes: a signed-in customer may fetch one code *by exact id* (to
    // validate what they typed) but can't list them all; only admins write.
    // The payments Worker re-validates the code itself before charging.
    match /coupons/{code} {
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
    }

    // "Request an item" (customer app → admin quote). A customer creates
    // their own as `new` and reads only theirs; only admins quote/close.
    match /item_requests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == 'new' && request.resource.data.link is string &&
        request.resource.data.link.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // Product reviews: public to read; one per customer per product (the doc
    // id is `{productId}_{uid}`, so a second review overwrites the first).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        reviewId == request.resource.data.productId + '_' + request.auth.uid &&
        request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Orders belong to the signed-in user who placed them (see
    // firestore_order_repository.dart). No guest orders — checkout requires
    // sign-in (see router.dart). Admins can read every order and update
    // status (processing, shipped, etc.); customers can only create/read
    // their own and never change status themselves.
    match /orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Generates the human-friendly "DL#####" order numbers. Any signed-in
    // client may read it and bump it by exactly 1 as part of placing an
    // order (see the transaction in firestore_order_repository.dart) — the
    // +1 check stops a client claiming an arbitrary block of numbers.
    match /meta/orderCounter {
      allow read: if request.auth != null;
      allow create: if false;
      allow update: if request.auth != null && request.resource.data.next == resource.data.next + 1;
    }

    // A customer's own saved delivery addresses (see AddressBookNotifier in
    // state/providers.dart) — entirely private, never read by anyone else
    // (not even admins; admins see the delivery address already captured on
    // each order, which is a separate, order-scoped copy).
    match /users/{uid}/addresses/{addressId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

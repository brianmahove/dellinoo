<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ launch screen icon: the Dellinoo "D" traces its outline,
     fills in black and pops into place (~0.9s). Generated from the Urbanist
     ExtraBold glyph so it matches the in-app logo and launcher icon. -->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="pop"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.8"
                android:scaleY="0.8">
                <path
                    android:name="outline"
                    android:pathData="M37.37 74V34H50.63Q54.77 34 58.39 35.56Q62 37.11 64.76 39.87Q67.51 42.63 69.07 46.24Q70.63 49.86 70.63 54Q70.63 58.14 69.07 61.76Q67.51 65.37 64.76 68.13Q62 70.89 58.39 72.44Q54.77 74 50.63 74ZM45.26 66.11H50.63Q53.09 66.11 55.27 65.18Q57.46 64.24 59.15 62.57Q60.84 60.9 61.79 58.71Q62.74 56.51 62.74 54Q62.74 51.49 61.79 49.3Q60.84 47.12 59.16 45.44Q57.48 43.76 55.3 42.82Q53.12 41.89 50.63 41.89H45.26Z"
                    android:strokeColor="#020910"
                    android:strokeWidth="2.2"
                    android:strokeLineJoin="round"
                    android:trimPathEnd="0" />
                <path
                    android:name="fill"
                    android:pathData="M37.37 74V34H50.63Q54.77 34 58.39 35.56Q62 37.11 64.76 39.87Q67.51 42.63 69.07 46.24Q70.63 49.86 70.63 54Q70.63 58.14 69.07 61.76Q67.51 65.37 64.76 68.13Q62 70.89 58.39 72.44Q54.77 74 50.63 74ZM45.26 66.11H50.63Q53.09 66.11 55.27 65.18Q57.46 64.24 59.15 62.57Q60.84 60.9 61.79 58.71Q62.74 56.51 62.74 54Q62.74 51.49 61.79 49.3Q60.84 47.12 59.16 45.44Q57.48 43.76 55.3 42.82Q53.12 41.89 50.63 41.89H45.26Z"
                    android:fillColor="#020910"
                    android:fillType="evenOdd"
                    android:fillAlpha="0" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 1. Trace the outline -->
    <target android:name="outline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="550"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- 2. Fill in -->
    <target android:name="fill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:startOffset="420"
                android:duration="300"
                android:interpolator="@android:interpolator/linear_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- 3. Pop into place -->
    <target android:name="pop">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.8"
                    android:valueTo="1"
                    android:startOffset="420"
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.8"
                    android:valueTo="1"
                    android:startOffset="420"
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>

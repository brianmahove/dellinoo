{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "mobile-billing-system-d2bfb",
          "appId": "1:239128341649:android:fa92d38452e837d462e330",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "mobile-billing-system-d2bfb",
          "configurations": { "android": "1:239128341649:android:fa92d38452e837d462e330" }
        }
      }
    }
  },
  "hosting": [
    {
      "target": "marketing",
      "public": "hosting",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "admin",
      "public": "admin/build/web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/@(index.html|flutter_bootstrap.js|main.dart.js|version.json|flutter_service_worker.js)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
        }
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}